-- 種目（バリエーションも種目の一種で、parent_id で親を指す）
CREATE TABLE exercise (
    id TEXT NOT NULL PRIMARY KEY,
    parent_id TEXT REFERENCES exercise(id) ON DELETE SET NULL,
    name TEXT NOT NULL,
    body_part TEXT NOT NULL,
    record_type TEXT NOT NULL,
    equipment TEXT NOT NULL,
    weight_mode TEXT NOT NULL,
    rep_mode TEXT NOT NULL,
    use_added_weight INTEGER NOT NULL DEFAULT 0,
    weight_step_kg REAL,
    memo TEXT NOT NULL DEFAULT '',
    sort_order INTEGER NOT NULL DEFAULT 0,
    hidden INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX exercise_parent ON exercise(parent_id);

selectAll:
SELECT * FROM exercise ORDER BY sort_order, name;

selectVisible:
SELECT * FROM exercise WHERE hidden = 0 ORDER BY sort_order, name;

selectById:
SELECT * FROM exercise WHERE id = ?;

insertExercise:
INSERT INTO exercise (
    id, parent_id, name, body_part, record_type, equipment, weight_mode, rep_mode,
    use_added_weight, weight_step_kg, memo, sort_order, hidden
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateExercise:
UPDATE exercise SET
    parent_id = :parentId,
    name = :name,
    body_part = :bodyPart,
    record_type = :recordType,
    equipment = :equipment,
    weight_mode = :weightMode,
    rep_mode = :repMode,
    use_added_weight = :useAddedWeight,
    weight_step_kg = :weightStepKg,
    memo = :memo,
    sort_order = :sortOrder,
    hidden = :hidden
WHERE id = :id;

deleteById:
DELETE FROM exercise WHERE id = ?;

hideById:
UPDATE exercise SET hidden = 1 WHERE id = ?;

count:
SELECT COUNT(*) FROM exercise;

maxSortOrder:
SELECT COALESCE(MAX(sort_order), -1) FROM exercise;

-- 記録（ワークアウト・ルーティン）で使われている回数。0 なら消してよい
usageInWorkouts:
SELECT COUNT(*) FROM workout_exercise WHERE exercise_id = ?;

usageInRoutines:
SELECT COUNT(*) FROM routine_item WHERE exercise_id = ?;
